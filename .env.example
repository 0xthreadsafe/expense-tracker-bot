# Token from @BotFather. Required.
BOT_TOKEN=123456:ABC-DEF_your_token_here

# "polling" for local development, "webhook" for a public deployment.
BOT_MODE=polling

# Required when BOT_MODE=webhook; ignored otherwise.
WEBHOOK_URL=https://bot.example.com
WEBHOOK_PORT=8080
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_SECRET=change-me

# SQLAlchemy async URL. Postgres example:
# postgresql+asyncpg://user:pass@localhost/expensebot
DATABASE_URL=sqlite+aiosqlite:///./data/expenses.db

# IANA timezone used for month boundaries and reminder scheduling.
TIMEZONE=Asia/Tehran

# Three-letter currency label shown next to amounts.
CURRENCY=IRR

# Locale for users whose Telegram language is not recognised: en | fa
DEFAULT_LOCALE=en

LOG_LEVEL=INFO
